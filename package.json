{
  "name": "j-eleven-media",
  "version": "1.0.0",
  "description": "J Eleven Media — Custom websites and online stores for East Tennessee businesses",
  "scripts": {
    "build": "node scripts/includes.js && npx tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "local": "node scripts/dev-server.js",
    "watch": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "dev": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch"
  },
  "type": "commonjs",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "resend": "^6.30.0",
    "tailwindcss": "^4.3.2",
    "validator": "^13.12.0",
    "zod": "^3.23.8"
  }
}
