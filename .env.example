# Copy this file to .env for local development (vercel dev), and set the
# same variables in your Vercel project's Environment Variables settings
# for Production/Preview. Never commit a real .env file to git.

# Origin allowed to call /api/contact and /api/csrf-token with credentials.
# Must be an exact origin (scheme + host), not a wildcard.
ALLOWED_ORIGIN=https://www.jelevenmedia.com

# Resend API key (https://resend.com/api-keys). Keep the real value in .env
# and in Vercel only — never in this file.
RESEND_API_KEY=re_your_api_key_here

# Sender address. Must be on a domain verified in Resend (e.g.
# contact@jelevenmedia.com). onboarding@resend.dev works for testing, but can
# only deliver to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=J Eleven Media <contact@jelevenmedia.com>

# Inbox that should receive contact form submissions.
CONTACT_TO_EMAIL=you@example.com
